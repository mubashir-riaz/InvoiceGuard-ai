# .env.example
# Environment variables for local development.

# FastAPI
PROJECT_NAME=InvoiceGuard-ai
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL (used from Phase 1 onward, can be placeholder in Phase 0)
DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/InvoiceGuard-ai
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=InvoiceGuard-ai

# Redis (used by worker)
REDIS_URL=redis://redis:6379/0

# Frontend (Vite dev server)
VITE_API_URL=http://localhost:8000