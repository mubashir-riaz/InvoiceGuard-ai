# .env.example
# Environment variables for local development.

# FastAPI
PROJECT_NAME=InvoiceGuard-ai
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL Credentials & Connection
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=invoiceguard_ai
DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/invoiceguard_ai

# Redis (used by worker)
REDIS_URL=redis://redis:6379/0

# Frontend (Vite dev server)
VITE_API_URL=http://localhost:8000

# Choose your LLM provider: "groq" or "gemini"
LLM_PROVIDER=groq

# Groq
GROQ_API_KEY=your-groq-api-key-here

# Google Gemini (backup)
GEMINI_API_KEY=your-gemini-api-key-here

# Shared upload directory 
UPLOAD_DIR=/app/uploads